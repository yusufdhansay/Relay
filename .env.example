# Copy this file to .env and adjust the values. Never commit .env.

RELAY_ENVIRONMENT=development
RELAY_LOG_LEVEL=INFO
RELAY_LOG_FORMAT=json

# SQLite by default. The data/ folder is git-ignored.
RELAY_DATABASE_URL=sqlite+aiosqlite:///./data/relay.db
RELAY_AUTO_CREATE_SCHEMA=true

# LLM provider: "mock" (deterministic, no API key) or "openai"
RELAY_LLM_PROVIDER=mock
RELAY_LLM_MODEL=gpt-4o-mini
RELAY_LLM_TEMPERATURE=0
RELAY_LLM_TIMEOUT_SECONDS=60
# RELAY_OPENAI_API_KEY=
# RELAY_OPENAI_BASE_URL=https://api.openai.com/v1

# Human approvers. Format: name:token,name:token
# Replace these demo values with long random tokens.
RELAY_APPROVER_TOKENS=alice:change-me-alice,bob:change-me-bob

# Orchestration limits
RELAY_MAX_STEPS_PER_RUN=60
RELAY_MAX_PLAN_TASKS=10
RELAY_MAX_WORKFLOW_RETRIES=1

# Tool execution
RELAY_TOOL_TIMEOUT_SECONDS=10
RELAY_TOOL_MAX_ATTEMPTS=3
RELAY_RETRY_BASE_DELAY_SECONDS=0.2
RELAY_RETRY_MAX_DELAY_SECONDS=2

RELAY_RECOVER_ON_STARTUP=false
